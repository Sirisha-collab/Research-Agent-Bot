# ---------------------------------------------------------------- LLM
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

DEEPSEEK_API_KEY=

EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- retrieval
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=45
TOP_K=6
MIN_SCORE=0.25
MAX_RETRIEVAL_LOOPS=2

# ---------------------------------------------------------------- extraction
ENABLE_CAMELOT=true
ENABLE_IMAGES=true
CAMELOT_MAX_PAGES=30

# ---------------------------------------------------------------- servers
API_HOST=127.0.0.1
API_PORT=8000
GRADIO_PORT=7860
GRADIO_SHARE=false
